{
  "name": "snub-io",
  "version": "0.1.0",
  "private": true,
  "description": "ignore the noise, on purpose - intentional signal filtering and focus amplification",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "web": "cd apps/web && npm run dev",
    "extension": "cd apps/extension && npm run dev"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Katastrophos/snub.io"
  },
  "author": "Katastrophos",
  "license": "MIT"
}
